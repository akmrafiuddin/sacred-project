# ==============================================================================
# ENVIRONMENT VARIABLES & SECRETS CONFIGURATION
# ==============================================================================

# Better Auth Configuration
# Secret key used for signing session tokens and cookies (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Registration gate: default false (set to true only when public devotee sign-up is permitted)
ALLOW_PUBLIC_SIGNUP="false"

# Initial Super Admin Seed Credentials (used by `bun run seed:admin`)
ADMIN_EMAIL="admin@temple.org"
ADMIN_PASSWORD="temporary-secure-admin-password-123!"

# Cloudflare Turnstile (Spam Protection for Public Forms)
# Public sitekey for frontend widget:
NUXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Secret key for server-side token verification:
TURNSTILE_SECRET=""

# Cloudflare Bindings (configured in wrangler.jsonc):
# DB = Cloudflare D1 Database binding
# MEDIA = Cloudflare R2 Bucket binding
